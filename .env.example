# ─── REQUIRED ──────────────────────────────────────────────────────────────────
# ntfy.sh push notification topic.
# Generate a secure one: python -c "import secrets; print(secrets.token_hex(16))"
# Then subscribe to it in the ntfy app on your phone.
NTFY_TOPIC=your-32-char-random-hex-topic-here

# GitHub Gist ID for persistent state storage between runs.
# Create a secret Gist at https://gist.github.com (content doesn't matter at first).
# The Gist ID is the long string at the end of the Gist URL.
GIST_ID=your-gist-id-here

# GitHub Personal Access Token with "gist" scope.
# Create one at https://github.com/settings/tokens (classic) → select "gist" checkbox.
GIST_TOKEN=ghp_your_github_personal_access_token_here

# ─── OPTIONAL: EMAIL (set email.enabled: true in config.yaml to use) ──────────
EMAIL_SMTP_USER=you@gmail.com
EMAIL_SMTP_PASSWORD=your-gmail-app-password-here
EMAIL_TO=you@gmail.com
